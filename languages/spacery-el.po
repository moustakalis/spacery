msgid "Name"
msgstr "Όνομα"

#: src/settings/BreakpointRows.js:32
msgid "Shown in the editor, e.g. Laptop."
msgstr "Εμφανίζεται στον επεξεργαστή, π.χ. Φορητός."

#: src/settings/BreakpointRows.js:38
msgid "Slug"
msgstr "Σύντομο όνομα"

#: src/settings/BreakpointRows.js:38
