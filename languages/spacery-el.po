#. Plugin Name of the plugin
#: spacery.php includes/Settings/Screen.php:115
#: includes/Settings/Screen.php:116 build/extension.js:10 build/settings.js:3
msgid "Spacery"
msgstr ""

#. Plugin URI of the plugin
#: spacery.php
msgid "https://github.com/moustakalis/spacery"
msgstr ""

#. Description of the plugin
#: spacery.php
msgid ""
"Responsive padding, margin and spacer height on any block, at the "
"breakpoints your design uses."
msgstr ""
"Αποκρίσιμα εσωτερικά και εξωτερικά περιθώρια και ύψος κενού σε κάθε μπλοκ, "
"στα σημεία διακοπής που χρησιμοποιεί ο σχεδιασμός σας."

#. Author of the plugin
#: spacery.php
msgid "Nickos Moustakas"
msgstr ""

#. Author URI of the plugin
#: spacery.php
msgid "https://github.com/moustakalis"
msgstr ""

#: includes/Blocks/Spacer.php:66
msgid ""
"Spacery has no build output. If you installed it from source, run \"pnpm "
"install && pnpm run build\"."
msgstr ""
"Το Spacery δεν έχει αρχεία build. Αν το εγκαταστήσατε από τον πηγαίο κώδικα, "
"εκτελέστε «pnpm install && pnpm run build»."

#: includes/Breakpoints/Registry.php:107
msgid "Desktop"
msgstr "Υπολογιστής"

#: includes/Breakpoints/Registry.php:108
msgid "Laptop"
msgstr "Φορητός"

#: includes/Breakpoints/Registry.php:109
msgid "Tablet"
msgstr "Τάμπλετ"

#: includes/Breakpoints/Registry.php:110
msgid "Mobile"
msgstr "Κινητό"

#. translators: 1: required PHP version, 2: running PHP version.
#: includes/Requirements.php:61
#, php-format
msgid "Spacery requires PHP %1$s or newer. This site is running PHP %2$s."
msgstr ""
"Το Spacery απαιτεί PHP %1$s ή νεότερη. Αυτός ο ιστότοπος εκτελεί PHP %2$s."

#. translators: 1: required WordPress version, 2: running WordPress version.
#: includes/Requirements.php:67
#, php-format
msgid ""
"Spacery requires WordPress %1$s or newer. This site is running WordPress "
"%2$s."
msgstr ""
"Το Spacery απαιτεί WordPress %1$s ή νεότερο. Αυτός ο ιστότοπος εκτελεί "
"WordPress %2$s."

#: includes/Settings/Options.php:73 build/settings.js:22
msgid "Breakpoint source"
msgstr "Πηγή σημείων διακοπής"

#: includes/Settings/Options.php:74
msgid "Which set of breakpoints Spacery uses."
msgstr "Ποιο σύνολο σημείων διακοπής χρησιμοποιεί το Spacery."

#: includes/Settings/Options.php:102
msgid "Custom breakpoints"
msgstr "Προσαρμοσμένα σημεία διακοπής"

#: includes/Settings/Options.php:103
msgid "Breakpoints defined on the Spacery settings screen."
msgstr "Σημεία διακοπής ορισμένα στην οθόνη ρυθμίσεων του Spacery."

#: includes/Settings/Options.php:133
msgid "Delete data on uninstall"
msgstr "Διαγραφή δεδομένων κατά την απεγκατάσταση"

#: includes/Settings/Options.php:134
msgid "Whether to remove Spacery's stored settings when the plugin is deleted."
msgstr ""
"Αν θα αφαιρεθούν οι αποθηκευμένες ρυθμίσεις του Spacery όταν διαγραφεί το "
"πρόσθετο."

#: includes/Settings/Options.php:241
msgid ""
"Those breakpoints were not saved. Every breakpoint needs a name and a width "
"in px, em or rem, widths must all differ, and there is a maximum of 12."
msgstr ""
"Αυτά τα σημεία διακοπής δεν αποθηκεύτηκαν. Κάθε σημείο διακοπής χρειάζεται "
"όνομα και πλάτος σε px, em ή rem, όλα τα πλάτη πρέπει να διαφέρουν, και το "
"ανώτατο όριο είναι 12."

#. translators: %s: breakpoint name. Marks a tier that has values set.
#: build/blocks/spacer/index.js:2 build/extension.js:2
msgid "%s (has values)"
msgstr "%s (έχει τιμές)"

#: build/blocks/spacer/index.js:2 build/extension.js:2
msgid "Breakpoint"
msgstr "Σημείο διακοπής"

#. translators: %s: breakpoint name.
#: build/blocks/spacer/index.js:3 build/extension.js:3
msgid "The canvas is still previewing %s."
msgstr "Ο καμβάς εξακολουθεί να προβάλλει %s."

#: build/blocks/spacer/index.js:3 build/extension.js:3
msgid "Responsive editing is off for this site, so the canvas does not follow."
msgstr ""
"Η αποκρίσιμη επεξεργασία είναι ανενεργή σε αυτόν τον ιστότοπο, οπότε ο "
"καμβάς δεν ακολουθεί."

#: build/blocks/spacer/index.js:3 build/extension.js:7
msgid "Set here"
msgstr "Ορίστηκε εδώ"

#. translators: %s: the breakpoint a value is inherited from.
#. translators: %s: a breakpoint name, or "this block's own spacing".
#: build/blocks/spacer/index.js:4 build/extension.js:8
msgid "Inherited from %s"
msgstr "Κληρονομείται από %s"

#: build/blocks/spacer/index.js:4
msgid "No height set"
msgstr "Δεν έχει οριστεί ύψος"

#: build/blocks/spacer/index.js:4
msgid "Inherited from Default"
msgstr "Κληρονομείται από την Προεπιλογή"

#. translators: 1: breakpoint name, 2: its upper bound, e.g. "Laptop · ≤1024px".
#: build/blocks/spacer/index.js:5 build/extension.js:7
msgid "%1$s · ≤%2$s"
msgstr "%1$s · ≤%2$s"

#: build/blocks/spacer/index.js:5 build/blocks/spacer/index.js:6
msgid "Height"
msgstr "Ύψος"

#: build/blocks/spacer/index.js:5
msgid "Reset"
msgstr "Επαναφορά"

#. translators: %s: breakpoint name.
#: build/blocks/spacer/index.js:6
msgid "%s (editing)"
msgstr "%s (σε επεξεργασία)"

#: build/blocks/spacer/index.js:6
msgid "Default"
msgstr "Προεπιλογή"

#: build/blocks/spacer/index.js:6
msgid "Applies at every width unless a narrower breakpoint overrides it."
msgstr ""
"Ισχύει σε κάθε πλάτος, εκτός αν το αντικαταστήσει ένα στενότερο σημείο "
"διακοπής."

#: build/blocks/spacer/index.js:6
msgid "Set at"
msgstr "Ορισμένα σε"

#: build/extension.js:1
msgid "Padding"
msgstr "Εσωτερικό περιθώριο"

#: build/extension.js:1
msgid "Margin"
msgstr "Εξωτερικό περιθώριο"

#: build/extension.js:1
msgid "Top"
msgstr "Πάνω"

#: build/extension.js:1
msgid "Right"
msgstr "Δεξιά"

#: build/extension.js:1
msgid "Bottom"
msgstr "Κάτω"

#: build/extension.js:1
msgid "Left"
msgstr "Αριστερά"

#: build/extension.js:3
msgid "this block's own spacing"
msgstr "τα ίδια τα κενά αυτού του μπλοκ"

#: build/extension.js:3
msgid "css"
msgstr "css"

#: build/extension.js:3
msgid "Unit"
msgstr "Μονάδα"

#: build/extension.js:3
msgid "Unlink sides"
msgstr "Αποσύνδεση πλευρών"

#: build/extension.js:3
msgid "Link sides — one value for all four"
msgstr "Σύνδεση πλευρών — μία τιμή και για τις τέσσερις"

#. translators: %s: a spacing property, e.g. "Padding".
#: build/extension.js:4
msgid "Reset %s"
msgstr "Επαναφορά: %s"

#: build/extension.js:4
msgid "A length, calc() or a preset, one per side. Anything else is dropped."
msgstr ""
"Μήκος, calc() ή προεπιλογή, ένα ανά πλευρά. Οτιδήποτε άλλο απορρίπτεται."

#. translators: %d: number of values WordPress sets for narrower screens.
#: build/extension.js:5
msgid "WordPress already sets %d value here for narrower screens."
msgid_plural "WordPress already sets %d values here for narrower screens."
msgstr[0] "Το WordPress ορίζει ήδη %d τιμή εδώ για στενότερες οθόνες."
msgstr[1] "Το WordPress ορίζει ήδη %d τιμές εδώ για στενότερες οθόνες."

#: build/extension.js:5
msgid ""
"In Spacery they also reach narrower screens, unless a narrower breakpoint "
"sets its own value."
msgstr ""
"Στο Spacery φτάνουν και σε στενότερες οθόνες, εκτός αν κάποιο στενότερο "
"σημείο διακοπής ορίσει δική του τιμή."

#: build/extension.js:5
msgid "Manage these in Spacery"
msgstr "Διαχείριση από το Spacery"

#. translators: %s: comma-separated list of WordPress viewport names.
#: build/extension.js:6
msgid "Leaving %s to WordPress: no Spacery breakpoint covers the same widths."
msgstr ""
"Το %s παραμένει στο WordPress: κανένα σημείο διακοπής του Spacery δεν "
"καλύπτει τα ίδια πλάτη."

#: build/extension.js:6
msgid "This site has no breakpoints, so there is nothing to set here yet."
msgstr ""
"Αυτός ο ιστότοπος δεν έχει σημεία διακοπής, οπότε δεν υπάρχει ακόμη κάτι να "
"οριστεί εδώ."

#: build/extension.js:6
msgid "This theme has spacing controls switched off for this block."
msgstr ""
"Αυτό το θέμα έχει απενεργοποιημένα τα χειριστήρια κενών για αυτό το μπλοκ."

#: build/extension.js:7
msgid "Reset all"
msgstr "Επαναφορά όλων"

#: build/extension.js:7
msgid "Partly set here"
msgstr "Ορίστηκε εν μέρει εδώ"

#. translators: 1: a breakpoint name. 2: another breakpoint name.
#: build/extension.js:9
msgid "Inherited from %1$s and %2$s"
msgstr "Κληρονομείται από %1$s και %2$s"

#. translators: %d: how many places a box's values come from.
#: build/extension.js:10
msgid "Inherited from %d different places"
msgstr "Κληρονομείται από %d διαφορετικά σημεία"

#: build/extension.js:10
msgid "Spacery — this block has responsive values"
msgstr "Spacery — αυτό το μπλοκ έχει αποκρίσιμες τιμές"

#. translators: 1: a CSS length. 2: a wider CSS length.
#: build/settings.js:2
msgid "over %1$s, up to %2$s"
msgstr "πάνω από %1$s, έως %2$s"

#. translators: %s: a CSS length, e.g. "480px".
#: build/settings.js:3
msgid "up to %s"
msgstr "έως %s"

#: build/settings.js:3
msgid "Nothing — no screens left"
msgstr "Τίποτα — δεν μένει καμία οθόνη"

#. translators: %s: the plugin version.
#: build/settings.js:4
msgid "Spacery %s"
msgstr "Spacery %s"

#: build/settings.js:4
msgid "Documentation"
msgstr "Τεκμηρίωση"

#: build/settings.js:4
msgid "Support"
msgstr "Υποστήριξη"

#: build/settings.js:4
msgid "Name"
msgstr "Όνομα"

#: build/settings.js:4
msgid "Slug"
msgstr "Σύντομο όνομα"

#: build/settings.js:4 build/settings.js:5
msgid "Up to"
msgstr "Έως"

#: build/settings.js:4
msgid "Covers"
msgstr "Καλύπτει"

#. translators: %s: the slug the breakpoint was saved under.
#: build/settings.js:5
msgid ""
"Values saved under %s will stop applying. To rename it, change the name and "
"leave the slug alone."
msgstr ""
"Οι τιμές που αποθηκεύτηκαν με το %s θα πάψουν να ισχύουν. Για μετονομασία, "
"αλλάξτε το όνομα και αφήστε το slug ως έχει."

#. translators: %s: breakpoint name.
#: build/settings.js:6
msgid "Remove %s"
msgstr "Αφαίρεση %s"

#: build/settings.js:6
msgid "Add breakpoint"
msgstr "Προσθήκη σημείου διακοπής"

#. translators: %d: maximum number of breakpoints.
#: build/settings.js:7 build/settings.js:22
msgid "%d breakpoints is the maximum."
msgstr "Τα %d σημεία διακοπής είναι το ανώτατο όριο."

#: build/settings.js:7
msgid ""
"Name appears in the editor. Slug is stored on your blocks and follows the "
"name until you edit it."
msgstr ""
"Το όνομα εμφανίζεται στον επεξεργαστή. Το slug αποθηκεύεται στα μπλοκ σας "
"και ακολουθεί το όνομα μέχρι να το επεξεργαστείτε."

#: build/settings.js:7
msgid "You haven't defined any breakpoints yet"
msgstr "Δεν έχετε ορίσει ακόμη σημεία διακοπής"

#. translators: %s: the breakpoint set in use meanwhile.
#: build/settings.js:8
msgid "Until you add one, Spacery uses %s — shown in In use now below."
msgstr ""
"Μέχρι να προσθέσετε ένα, το Spacery χρησιμοποιεί %s — αυτό που δείχνει η "
"ενότητα «Σε χρήση τώρα» παρακάτω."

#: build/settings.js:8
msgid "Add your first breakpoint"
msgstr "Προσθέστε το πρώτο σας σημείο διακοπής"

#. translators: 1: breakpoint name. 2: a CSS length.
#: build/settings.js:9
msgid "%1$s to %2$s"
msgstr "%1$s έως %2$s"

#. translators: 1: breakpoint name. 2: the range it covers.
#: build/settings.js:10
msgid "%1$s, %2$s."
msgstr "%1$s, %2$s."

#: build/settings.js:10
msgid "no tier"
msgstr "κανένα σημείο"

#. translators: %s: a CSS length, e.g. "11920px".
#: build/settings.js:11
msgid "The widest band runs to %s and is cut short here."
msgstr "Η πλατύτερη ζώνη φτάνει έως %s και κόβεται εδώ."

#. translators: %s: a CSS length, e.g. "1280px".
#: build/settings.js:12
msgid ""
"Screens wider than %s match no breakpoint, so blocks use their ordinary "
"values. Raise the widest breakpoint to cover them."
msgstr ""
"Οθόνες πλατύτερες από %s δεν αντιστοιχούν σε κανένα σημείο διακοπής, οπότε "
"τα μπλοκ χρησιμοποιούν τις συνηθισμένες τους τιμές. Αυξήστε το πλατύτερο "
"σημείο διακοπής για να τις καλύψετε."

#. translators: 1: comma-separated breakpoint names. 2: how many further breakpoints there are.
#: build/settings.js:13
msgid "%1$s and %2$d more"
msgid_plural "%1$s and %2$d more"
msgstr[0] "%1$s και %2$d ακόμη"
msgstr[1] "%1$s και %2$d ακόμη"

#: build/settings.js:13
msgid "your theme"
msgstr "το θέμα σας"

#: build/settings.js:13
msgid "the breakpoints you defined"
msgstr "τα σημεία διακοπής που ορίσατε"

#: build/settings.js:13
msgid "Spacery's own set"
msgstr "το δικό του σύνολο του Spacery"

#: build/settings.js:13
msgid "a filter on this site"
msgstr "ένα φίλτρο σε αυτόν τον ιστότοπο"

#: build/settings.js:13
msgid "This theme — it declares no breakpoints"
msgstr "Αυτό το θέμα — δεν δηλώνει σημεία διακοπής"

#. translators: %s: a list of breakpoint names.
#: build/settings.js:14
msgid "This theme — %s"
msgstr "Αυτό το θέμα — %s"

#. translators: %s: the source that will be followed.
#: build/settings.js:15
msgid "Decide for me — currently %s"
msgstr "Ας αποφασίσει το Spacery — τώρα: %s"

#. translators: %s: a list of breakpoint names.
#: build/settings.js:16
msgid "Spacery's own — %s"
msgstr "Του ίδιου του Spacery — %s"

#: build/settings.js:16
msgid "Breakpoints I define below"
msgstr "Σημεία διακοπής που ορίζω παρακάτω"

#. translators: %d: how many problems are on the screen.
#: build/settings.js:17
msgid "Fix %d problem above to save."
msgid_plural "Fix %d problems above to save."
msgstr[0] "Διορθώστε %d πρόβλημα παραπάνω για αποθήκευση."
msgstr[1] "Διορθώστε %d προβλήματα παραπάνω για αποθήκευση."

#. translators: %d: how many breakpoints have been changed.
#: build/settings.js:18
msgid "Unsaved change to %d breakpoint."
msgid_plural "Unsaved changes to %d breakpoints."
msgstr[0] "Μη αποθηκευμένη αλλαγή σε %d σημείο διακοπής."
msgstr[1] "Μη αποθηκευμένες αλλαγές σε %d σημεία διακοπής."

#: build/settings.js:18
msgid "Unsaved change to the breakpoint source."
msgstr "Μη αποθηκευμένη αλλαγή στην πηγή σημείων διακοπής."

#: build/settings.js:18
msgid "Unsaved change to what happens on deletion."
msgstr "Μη αποθηκευμένη αλλαγή στο τι συμβαίνει κατά τη διαγραφή."

#: build/settings.js:18
msgid "No changes to save."
msgstr "Δεν υπάρχουν αλλαγές προς αποθήκευση."

#: build/settings.js:18
msgid "an unnamed breakpoint"
msgstr "ένα σημείο διακοπής χωρίς όνομα"

#. translators: %s: a narrower CSS length, e.g. "1920px".
#: build/settings.js:19
msgid "Too wide for the ruler. Did you mean %s?"
msgstr "Πολύ πλατύ. Μήπως εννοούσατε %s;"

#: build/settings.js:19
msgid "Too wide for the ruler."
msgstr "Πολύ πλατύ για τον χάρακα."

#: build/settings.js:19
msgid "Loading your breakpoints…"
msgstr "Φόρτωση των σημείων διακοπής σας…"

#: build/settings.js:19
msgid "Needs a name — this is what you pick in the editor."
msgstr "Χρειάζεται όνομα — αυτό επιλέγετε στον επεξεργαστή."

#: build/settings.js:19
msgid "Lowercase letters, numbers and dashes only."
msgstr "Μόνο πεζά λατινικά γράμματα, αριθμοί και παύλες."

#: build/settings.js:19
msgid "Has to be more than zero."
msgstr "Πρέπει να είναι μεγαλύτερο από το μηδέν."

#: build/settings.js:19
msgid "Needs a number and a unit — px, em or rem."
msgstr "Χρειάζεται αριθμό και μονάδα — px, em ή rem."

#. translators: %s: the name of the breakpoint already using this slug.
#: build/settings.js:20
msgid "Already used by %s. Two breakpoints cannot share a slug."
msgstr ""
"Χρησιμοποιείται ήδη από το %s. Δύο σημεία διακοπής δεν μπορούν να έχουν το "
"ίδιο slug."

#. translators: %s: the name of the breakpoint at this width.
#: build/settings.js:21
msgid "Same width as %s."
msgstr "Ίδιο πλάτος με το %s."

#: build/settings.js:22
msgid "Only one source applies at a time — Spacery never merges two sets."
msgstr "Ισχύει μία πηγή κάθε φορά — το Spacery δεν συγχωνεύει ποτέ δύο σύνολα."

#: build/settings.js:22
msgid "Your breakpoints"
msgstr "Τα σημεία διακοπής σας"

#. translators: 1: how many breakpoints are defined. 2: the maximum.
#: build/settings.js:23
msgid "%1$d of %2$d · sorted widest first"
msgstr "%1$d από %2$d · ταξινομημένα από το πλατύτερο"

#: build/settings.js:23
msgid "In use now"
msgstr "Σε χρήση τώρα"

#. translators: %s: where the breakpoints come from.
#: build/settings.js:24
msgid "From: %s"
msgstr "Από: %s"

#: build/settings.js:24
msgid "When you delete Spacery"
msgstr "Όταν διαγράψετε το Spacery"

#: build/settings.js:24
msgid "Delete my settings when Spacery is deleted"
msgstr "Να διαγραφούν οι ρυθμίσεις μου όταν διαγραφεί το Spacery"

#: build/settings.js:24
msgid ""
"Your breakpoints go too. Values on your blocks stay, but a future install "
"may apply them at different widths."
msgstr ""
"Φεύγουν και τα σημεία διακοπής σας. Οι τιμές στα μπλοκ σας παραμένουν, αλλά "
"μια μελλοντική εγκατάσταση μπορεί να τις εφαρμόσει σε άλλα πλάτη."

#: build/settings.js:24
msgid ""
"Your breakpoints are kept, so reinstalling leaves your values exactly as "
"they are."
msgstr ""
"Τα σημεία διακοπής σας διατηρούνται, οπότε μια επανεγκατάσταση αφήνει τις "
"τιμές σας ακριβώς όπως είναι."

#: build/settings.js:24
msgid "Save changes"
msgstr "Αποθήκευση αλλαγών"

#: build/settings.js:24
msgid "Discard"
msgstr "Απόρριψη"

#: build/settings.js:24
msgid ""
"A spacery_breakpoints filter replaces the set, so these are stored but not "
"in use."
msgstr ""
"Ένα φίλτρο spacery_breakpoints αντικαθιστά το σύνολο, οπότε αυτά είναι "
"αποθηκευμένα αλλά δεν χρησιμοποιούνται."

#. translators: %s: the breakpoint set in use instead.
#: build/settings.js:25
msgid ""
"Your theme declares breakpoints Spacery could not read, so %s is in use."
msgstr ""
"Το θέμα σας δηλώνει σημεία διακοπής που το Spacery δεν μπόρεσε να διαβάσει, "
"οπότε χρησιμοποιείται %s."

#. translators: %s: the breakpoint set in use instead.
#: build/settings.js:26
msgid "You have not defined any yet, so %s is in use."
msgstr "Δεν έχετε ορίσει ακόμη κανένα, οπότε χρησιμοποιείται %s."

#. translators: %s: the breakpoint set in use instead.
#: build/settings.js:27
msgid "Your theme declares none Spacery can use, so %s is in use."
msgstr ""
"Το θέμα σας δεν δηλώνει κανένα που να μπορεί να χρησιμοποιήσει το Spacery, "
"οπότε χρησιμοποιείται %s."

#. translators: %s: the breakpoint set in use instead.
#: build/settings.js:28
msgid "The set you chose is empty, so %s is in use."
msgstr "Το σύνολο που επιλέξατε είναι κενό, οπότε χρησιμοποιείται %s."

#: build/settings.js:28
msgid "No breakpoints are active."
msgstr "Δεν υπάρχουν ενεργά σημεία διακοπής."

#: build/settings.js:28
msgid "Settings saved."
msgstr "Οι ρυθμίσεις αποθηκεύτηκαν."

#: build/settings.js:28
msgid "Settings saved. Reload the page to see what is in use."
msgstr ""
"Οι ρυθμίσεις αποθηκεύτηκαν. Φορτώστε ξανά τη σελίδα για να δείτε τι "
"χρησιμοποιείται."

#: build/settings.js:28
msgid ""
"Your source was saved. The breakpoints were not: each needs a name and a "
"width in px, em or rem, and no two may share a width."
msgstr ""
