<?xml version="1.0"?>
<ruleset name="Spacery">
	<description>Coding standards for Spacery.</description>

	<file>spacery.php</file>
	<file>includes</file>
	<file>tests</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<rule ref="WordPress-Extra">
		<!--
			Spacery autoloads PSR-4 (`Spacery\Foo\Bar` -> `includes/Foo/Bar.php`),
			so WordPress core's `class-foo-bar.php` file naming convention does not
			apply. This is the only WordPress-Extra rule deliberately dropped.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="spacery"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="spacery"/>
				<element value="Spacery"/>
			</property>
		</properties>
		<!--
			Tests stand in for WordPress: the bootstrap defines core's own
			functions (get_option, wp_get_global_settings, apply_filters) so the
			suite runs with no WordPress install, and the tests fire core's own
			hooks (update_option_*, switch_theme) to simulate a real request.
			Prefixing either would defeat the purpose. Nothing under tests/ ships.
		-->
		<exclude-pattern>tests/</exclude-pattern>
	</rule>

	<!--
		Those same stubs mirror core's signatures exactly, including parameters
		Spacery never reads. Narrowing them would make the stub a worse model of
		the function it stands in for.
	-->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>tests/</exclude-pattern>
	</rule>

	<!-- Match the minimum supported environment declared in the plugin header. -->
	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="8.2-"/>
	<rule ref="PHPCompatibilityWP"/>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<!-- Core source fetched for contract tests; not ours to lint. -->
	<exclude-pattern>tests/contract/core/*</exclude-pattern>
</ruleset>
